{
  "name": "kuma-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime Kuma-style monitoring on Cloudflare Workers + D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "schema:remote": "wrangler d1 execute kuma-lite-db --file=./schema.sql --remote",
    "schema:local": "wrangler d1 execute kuma-lite-db --file=./schema.sql --local",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.27.0",
    "chat": "^4.27.0"
  },
  "overrides": {
    "miniflare": {
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "sharp@<0.35.5": "0.35.5"
    }
  }
}
